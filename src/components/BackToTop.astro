<button class="back-to-top" id="back-to-top" aria-label="返回顶部" title="返回顶部">↑</button>

<style>
  .back-to-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    width: 42px; height: 42px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    backdrop-filter: blur(10px);
    color: var(--text);
    font-size: 1.1rem;
    cursor: pointer;
    opacity: 0;
    visibility: hidden; /* 移出 Tab 序与可访问性树 */
    pointer-events: none;
    transition: opacity 0.25s ease, box-shadow 0.25s ease;
    z-index: 90;
  }
  .back-to-top.show { opacity: 1; visibility: visible; pointer-events: auto; }
  .back-to-top:hover { box-shadow: var(--shadow-glow); }
</style>

<script>
  const btn = document.getElementById('back-to-top');
  if (btn) {
    const onScroll = () => btn.classList.toggle('show', window.scrollY > 400);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll(); // 页面加载时若已滚动（刷新/锚点跳转），立即同步状态
    btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  }
</script>
